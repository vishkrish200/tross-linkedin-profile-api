PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Access defaults to bearer. public-demo requires an explicit expiry and uses
# the bounded anonymous controls below.
ACCESS_MODE=bearer
API_KEY=
# Generate a token before startup, for example: openssl rand -hex 32
# Keep the prior token only during a bounded key-rotation window, then remove it.
# API_KEY_PREVIOUS=replace-with-a-distinct-32-character-token
# ALLOW_UNAUTHENTICATED_LOCAL=true

# PUBLIC_DEMO_EXPIRES_AT=2026-09-08T18:29:59Z
PUBLIC_DEMO_PER_CLIENT_RATE_LIMIT_MAX=120
PUBLIC_DEMO_GLOBAL_RATE_LIMIT_MAX=180
PUBLIC_DEMO_RATE_LIMIT_WINDOW='1 minute'
PUBLIC_DEMO_MAX_COLD_EXTRACTIONS=100

REQUEST_BODY_LIMIT_BYTES=8192
RATE_LIMIT_MAX=10
UNAUTHORIZED_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW='1 minute'

# Copy only the minimum cookies required from a session you are authorized to use.
# Never commit these values. LINKEDIN_CSRF_TOKEN may be omitted when the cookie
# contains JSESSIONID; its unquoted value is then used as the CSRF token.
LINKEDIN_COOKIE=
# LINKEDIN_CSRF_TOKEN=ajax:replace-me
# LINKEDIN_USER_AGENT=Mozilla/5.0 ...
LINKEDIN_REQUEST_TIMEOUT_MS=20000
LINKEDIN_EXTRACTION_TIMEOUT_MS=25000
LINKEDIN_MAX_RESPONSE_BYTES=5000000
LINKEDIN_MAX_CONCURRENCY=2
LINKEDIN_MAX_QUEUE_SIZE=4
LINKEDIN_BREAKER_COOLDOWN_SECONDS=900
LINKEDIN_REQUESTS_PER_MINUTE=60
LINKEDIN_MIN_REQUEST_INTERVAL_MS=100

CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=250
