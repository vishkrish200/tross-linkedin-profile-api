PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Require this token as `Authorization: Bearer <token>` when set.
API_KEY=replace-with-a-long-random-token

# Provide exactly one of these at runtime. Never commit the generated file.
LINKEDIN_STORAGE_STATE_PATH=.auth/linkedin.json
# LINKEDIN_STORAGE_STATE_B64=

CACHE_TTL_SECONDS=900
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1 minute
