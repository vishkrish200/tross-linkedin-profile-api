{
  "name": "tross-linkedin-profile-api",
  "version": "0.1.0",
  "private": true,
  "description": "A typed HTTP API for extracting structured data from a LinkedIn profile page.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "auth": "tsx scripts/save-linkedin-session.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "cheerio": "1.2.0",
    "fastify": "5.12.1",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
